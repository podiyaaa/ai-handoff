# Source & build tools — only dist/ ships
src/
out/
esbuild.js
tsconfig.json
tsconfig.test.json
.eslintrc.json

# Standalone webview dev harness (mock bridge + browser test page) —
# dev-only, never loaded by the real extension. media/webview/*.js is the
# actual shipped webview code and stays included.
webview-ui/

# JetBrains/Android Studio bridge POC — a separate proof-of-concept, not
# wired into this extension's own build; never ships in the .vsix.
jetbrains-poc/

